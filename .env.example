# Claude API key (https://console.anthropic.com). Leave blank for rules-only mode.
ANTHROPIC_API_KEY=

# Salesforce Developer Edition org. Leave SF_USERNAME blank to dry-run to out/leads.jsonl.
SF_USERNAME=
SF_PASSWORD=
# Settings > Reset My Security Token (emailed to you)
SF_SECURITY_TOKEN=
# "login" for production/dev orgs, "test" for sandboxes
SF_DOMAIN=login
DRY_RUN=0

# Shared secret for HMAC-SHA256 webhook signatures. Blank disables the check (local dev only).
WEBHOOK_SECRET=change-me
