# Claude API key (https://console.anthropic.com). Leave blank for rules-only mode.
ANTHROPIC_API_KEY=

# Salesforce, recommended: OAuth 2.0 client credentials from an External Client App.
# Leave SF_CLIENT_ID blank (and SF_USERNAME blank) to dry-run to out/leads.jsonl.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Your My Domain, e.g. orgfarm-abc123-dev-ed.develop.my.salesforce.com (Setup > My Domain)
SF_DOMAIN=

# Salesforce, legacy: username + password + security token (SOAP login).
# Disabled by default in orgs created Winter '26+, retired by Salesforce in Summer '27.
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

DRY_RUN=0

# Shared secret for HMAC-SHA256 webhook signatures. Blank disables the check (local dev only).
WEBHOOK_SECRET=change-me
